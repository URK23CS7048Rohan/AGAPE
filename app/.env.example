# Copy to .env and fill in. Without these, the app runs on built-in demo data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: pin a specific YouTube video on the Watch screen.
# Without it the app plays the live stream / latest uploads from Agape International Media.
EXPO_PUBLIC_YOUTUBE_VIDEO_ID=
# Public website URL (used to show images uploaded in /admin that live on the site)
EXPO_PUBLIC_SITE_URL=
