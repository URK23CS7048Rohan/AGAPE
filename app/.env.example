# Copy to app/.env and fill in (for the APK built on GitHub, add the same names as repository secrets).
# Supabase → Project Settings → API. The anon key is public by design; never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public website URL (shows images uploaded in /admin, links staff to /admin, password-reset page)
EXPO_PUBLIC_SITE_URL=
# Google Maps key for the ride map on Android (Google Cloud → Maps SDK for Android)
GOOGLE_MAPS_ANDROID_KEY=
