# Copy to .env and fill in. Without these, the app runs on built-in demo data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public website URL (used to show images uploaded in /admin that live on the site, and as the YouTube embed origin)
EXPO_PUBLIC_SITE_URL=
